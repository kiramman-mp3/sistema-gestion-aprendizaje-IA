# Variables NO secretas del despliegue de demostración en un homelab (docker-compose.homelab.yml).
# Copiar a .env.homelab (no se sube al repositorio). Los secretos van en archivos de SECRETS_DIR;
# ver docs/operacion/despliegue-homelab.md.

# Carpeta del servidor, fuera del repositorio, con: api.env, worker.env, db_password, redis_password y
# moodle_db_password.
SECRETS_DIR=/home/usuario/.config/smart-lms/secrets

# Dirección pública de Moodle (la que abre el navegador), su origen (esquema, host y puerto, para CORS) y su host.
# Con un puerto propio: https://servidor.ejemplo.ts.net:8444. En una ruta de un puerto compartido de Funnel:
# https://servidor.ejemplo.ts.net:10000/lms (ver docs/operacion/despliegue-homelab.md).
MOODLE_WWWROOT=https://servidor.ejemplo.ts.net:10000/lms
MOODLE_BASE_URL=https://servidor.ejemplo.ts.net:10000/lms
PUBLIC_ORIGIN=https://servidor.ejemplo.ts.net:10000
MOODLE_HOST=servidor.ejemplo.ts.net
# IP en la que el proxy del host (tailscale serve) atiende ese nombre (`tailscale ip -4`) y su puerto HTTPS.
MOODLE_PROXY_IP=100.64.0.1
MOODLE_PUBLIC_PORT=10000
# IP del bridge de Docker (docker network inspect bridge): ahí escucha el relé que usa el backend para llegar a Moodle.
RELAY_BIND_IP=172.17.0.1

# Puertos locales (solo 127.0.0.1) que el proxy del host publica con HTTPS.
MOODLE_PORT=8090
API_PORT=8091

# docker-compose.prod.yml las exige aunque el proxy Caddy no se use aquí.
API_DOMAIN=no-se-usa.invalid
ACME_EMAIL=no-se-usa@invalid

LOG_LEVEL=info
