# Variables NO secretas del despliegue de producción. Copiar a .env.production (que no se sube al repositorio).
# Los secretos van en archivos de SECRETS_DIR; ver docs/operacion/instalacion-y-operacion.md.

# Carpeta del servidor, fuera del repositorio, con: api.env, worker.env, db_password y redis_password.
SECRETS_DIR=/etc/smart-lms/secrets

# Dominio público del backend (el navegador lo llama desde Moodle) y correo para Let's Encrypt.
API_DOMAIN=asistente.ejemplo.edu.ec
ACME_EMAIL=admin@ejemplo.edu.ec

# Dirección (wwwroot) de Moodle. También es el origen CORS permitido.
MOODLE_BASE_URL=https://moodle.ejemplo.edu.ec

LOG_LEVEL=info
