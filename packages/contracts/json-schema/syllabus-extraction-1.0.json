{
  "$id": "https://smart-lms.local/schemas/syllabus-extraction-1.0.json",
  "title": "Extracción estructurada de sílabo v1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "course": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": ["string", "null"]
        },
        "period": {
          "type": ["string", "null"]
        },
        "teacher": {
          "type": ["string", "null"]
        },
        "generalObjective": {
          "type": ["string", "null"]
        }
      },
      "required": ["name", "code", "period", "teacher", "generalObjective"],
      "additionalProperties": false
    },
    "learningOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "description"],
        "additionalProperties": false
      }
    },
    "gradingPeriods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "learningOutcomeIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._-]+$"
                  }
                },
                "startDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "endDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "activities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "assignment",
                          "forum",
                          "quiz",
                          "exam",
                          "practice",
                          "project",
                          "resource",
                          "other"
                        ]
                      },
                      "description": {
                        "type": ["string", "null"]
                      },
                      "suggestedDueDate": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "weight": {
                        "anyOf": [
                          {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "learningOutcomeIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._-]+$"
                        }
                      },
                      "requiresTeacherReview": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "title",
                      "type",
                      "description",
                      "suggestedDueDate",
                      "weight",
                      "learningOutcomeIds",
                      "requiresTeacherReview"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "title",
                "topics",
                "learningOutcomeIds",
                "startDate",
                "endDate",
                "activities"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "weight", "units"],
        "additionalProperties": false
      }
    },
    "methodologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assessmentInstruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name", "weight"],
        "additionalProperties": false
      }
    },
    "bibliography": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainFields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "enum": ["missing", "ambiguous", "low_confidence", "inconsistent"]
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["path", "reason", "note"],
        "additionalProperties": false
      }
    },
    "sourceReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["path", "page", "excerpt"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "course",
    "learningOutcomes",
    "gradingPeriods",
    "methodologies",
    "resources",
    "assessmentInstruments",
    "bibliography",
    "uncertainFields",
    "sourceReferences"
  ],
  "additionalProperties": false
}
