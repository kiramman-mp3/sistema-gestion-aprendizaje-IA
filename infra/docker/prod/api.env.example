# Plantilla de ${SECRETS_DIR}/api.env. Copiar al servidor, completar y proteger: chmod 600, dueño root.
# NUNCA subir el archivo con valores reales al repositorio.

# Misma contraseña que ${SECRETS_DIR}/db_password.
DATABASE_URL=postgresql://app:CONTRASEÑA_DE_LA_BASE@app-db:5432/ai_assistant
# Misma contraseña que ${SECRETS_DIR}/redis_password.
REDIS_URL=redis://:CONTRASEÑA_DE_REDIS@redis:6379
# Token del usuario de integración de Moodle (setup_integration.php lo imprime una sola vez).
MOODLE_TOKEN=
# Secreto compartido con el plugin (ajuste "jwtsecret"): al menos 32 caracteres aleatorios.
PLUGIN_JWT_SECRET=
# Proveedor de IA (D-07), cuando se defina.
AI_PROVIDER=
AI_API_KEY=
