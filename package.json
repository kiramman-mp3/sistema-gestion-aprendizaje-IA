{
  "name": "smart-lms",
  "version": "0.0.0",
  "private": true,
  "description": "LMS inteligente basado en Moodle con asistente de IA para docentes",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:api": "redocly lint docs/api/openapi.yaml",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build:amd": "rollup -c infra/amd/rollup.config.mjs",
    "check:amd": "pnpm build:amd && git diff --exit-code -- moodle",
    "eval:extraction": "node infra/scripts/evaluate-extraction.mjs",
    "mock:ai": "pnpm --filter @smart-lms/mocks ai",
    "loadtest": "node infra/loadtest/load.mjs",
    "smoke:publicacion": "node infra/scripts/smoke-publicacion.mjs",
    "smoke:asistente": "node infra/scripts/smoke-asistente.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.71.1",
    "@rollup/plugin-terser": "1.0.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rollup": "4.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
