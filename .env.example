# Copiar a .env y completar. Nunca subir .env al repositorio.

# Backend (pnpm dev en el host)
PORT=3000

# Base auxiliar (PostgreSQL + pgvector). Puerto del host distinto de 5432 para no chocar con otras bases.
APP_DB_PORT=5433
APP_DB_PASSWORD=
DATABASE_URL=postgresql://app:${APP_DB_PASSWORD}@localhost:${APP_DB_PORT}/ai_assistant

# Redis (cola de trabajos)
REDIS_PORT=6379
REDIS_URL=redis://localhost:${REDIS_PORT}

# Moodle (moodle-docker en el host, ver infra/scripts/moodle.sh)
MOODLE_BASE_URL=http://localhost:8000
# Lo imprime infra/scripts/moodle.sh install al crear el usuario de integración.
MOODLE_TOKEN=
# Contraseña del administrador de la instancia local de desarrollo.
MOODLE_ADMIN_PASSWORD=

# Orígenes del navegador que pueden llamar al backend (wwwroot de Moodle), separados por comas
CORS_ORIGINS=http://localhost:8000

# Peticiones por usuario y minuto antes de responder 429 (0 lo desactiva; útil para pruebas de carga)
RATE_LIMIT_PER_MINUTE=120

# Archivos subidos (relativo a apps/api) y días que se conservan los originales de los sílabos
STORAGE_DIR=var/storage
SYLLABUS_RETENTION_DAYS=30

# Worker documental en Docker con el backend en el host (docker compose --profile worker up -d):
# carpeta del host que el worker monta en solo lectura. Con --profile api se usa un volumen.
# WORKER_STORAGE_SOURCE=./apps/api/var/storage

# Antivirus (docker compose --profile antivirus up -d). Sin valor, los archivos no se analizan;
# en producción es obligatorio.
CLAMAV_PORT=3310
CLAMAV_URL=tcp://localhost:${CLAMAV_PORT}

# Firma de JWT entre el plugin y el backend (secreto compartido)
PLUGIN_JWT_SECRET=

# Proveedor de IA (por definir, ver D-07)
AI_PROVIDER=
AI_API_KEY=
