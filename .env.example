# Copiar a .env y completar. Nunca subir .env al repositorio.

# Base auxiliar (PostgreSQL + pgvector)
APP_DB_PASSWORD=
DATABASE_URL=postgresql://app:${APP_DB_PASSWORD}@localhost:5432/ai_assistant

# Redis (cola de trabajos)
REDIS_URL=redis://localhost:6379

# Moodle (moodle-docker en el host, ver infra/scripts/moodle.sh)
MOODLE_BASE_URL=http://localhost:8000
# Lo imprime infra/scripts/moodle.sh install al crear el usuario de integración.
MOODLE_TOKEN=
# Contraseña del administrador de la instancia local de desarrollo.
MOODLE_ADMIN_PASSWORD=

# Firma de JWT entre el plugin y el backend (secreto compartido)
PLUGIN_JWT_SECRET=

# Proveedor de IA (por definir, ver D-07)
AI_PROVIDER=
AI_API_KEY=
