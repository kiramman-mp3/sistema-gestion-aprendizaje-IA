{
  "name": "@smart-lms/document-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker documental: extrae texto de sílabos PDF y DOCX (ADR-003)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smart-lms/contracts": "workspace:*",
    "bullmq": "6.4.2",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "pdfjs-dist": "6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
